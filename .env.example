# ---- LLM (DeepSeek, OpenAI 兼容) ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
KB_MODEL=deepseek-v4-flash          # 工具/结构化节点用(支持 function calling)
KB_JUDGE_MODEL=deepseek-v4-pro      # writer 纯推理用(pro 推理更强;不调工具)

# ---- Embedding + Rerank (阿里通义 DashScope;留空则降级到哈希向量) ----
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
RERANK_MODEL=gte-rerank-v2

# ---- 向量库 Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
KB_COLLECTION=kb_notes

# ---- 可观测 Langfuse (留空则降级到本地 trace 打印;或填云 key) ----
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
